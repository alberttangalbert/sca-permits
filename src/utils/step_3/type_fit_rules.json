{
  "_doc": "Ordered type_fit rules for San Carlos EnerGov permit types. First rule whose `match` is a substring of the lowercased case_type wins. Authored from the real 2025-2026 type vocabulary (docs/handoff/record-types-and-scoring.md). Bullseye for the GC: new SFR / ADU / addition / substantial remodel that is approved-or-near but pre-contractor. Sub-trades, admin, and (for this residential GC) commercial score low. The `category` is a coarse tag for reporting; `type_fit` is the 0-1 score. Order matters: combined/specific rules precede generic ones, and the `commercial` rule precedes generic residential-feature rules so 'Building Commercial-Addition' isn't read as a residential addition.",
  "fallback": { "type_fit": 0.3, "category": "OTHER" },
  "rules": [
    { "match": "new single family", "type_fit": 1.0, "category": "NEW_SFR" },
    { "match": "sb9", "type_fit": 1.0, "category": "NEW_SFR" },
    { "match": "reconstruction", "type_fit": 1.0, "category": "NEW_SFR" },
    { "match": "second dwelling unit", "type_fit": 1.0, "category": "ADU" },
    { "match": "jadu", "type_fit": 0.95, "category": "ADU" },
    { "match": "adu", "type_fit": 1.0, "category": "ADU" },
    { "match": "accessory dwelling", "type_fit": 1.0, "category": "ADU" },

    { "match": "commercial", "type_fit": 0.2, "category": "COMMERCIAL" },

    { "match": "addition", "type_fit": 0.9, "category": "ADDITION" },
    { "match": "interior remodel", "type_fit": 0.75, "category": "REMODEL" },
    { "match": "kitchen remodel", "type_fit": 0.6, "category": "REMODEL" },
    { "match": "bathroom remodel", "type_fit": 0.4, "category": "REMODEL" },
    { "match": "accessory structure", "type_fit": 0.7, "category": "OTHER" },
